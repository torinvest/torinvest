RewriteEngine On

# Bloquer l'accès HTTP au dossier data/ (users, sessions, SQLite)
RewriteRule ^data(/|$) - [F,L]

# Bloquer l'accès direct au fichier de configuration
<Files "config.local.php">
    Require all denied
</Files>

<Files "config.example.php">
    Require all denied
</Files>

<Files "admin-licence-lib.php">
    Require all denied
</Files>

<Files "brevo-lib.php">
    Require all denied
</Files>

<Files "stripe-lib.php">
    Require all denied
</Files>

<FilesMatch "\.(db|sqlite|sqlite3)$">
    Require all denied
</FilesMatch>
