# ------------------------------------------------------------------
# USA WAR ATLAS - Variables d'environnement (exemple, sans secret)
# Copier ce fichier vers .env puis adapter les valeurs.
# ------------------------------------------------------------------

# Base de données
# SQLite en développement local. Pour PostgreSQL plus tard :
# DATABASE_URL="postgresql://user:password@localhost:5432/usa_war_atlas"
DATABASE_URL="file:./dev.db"

# API
# Dev local : 3001. Prod VPS (à côté de La Forge) : 3011
API_PORT=3011
NODE_ENV=development

# CORS : origine(s) autorisée(s), séparées par des virgules
# Prod : https://app.torinvest-trading.com
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Administration (MVP : jeton simple - à remplacer par une vraie auth plus tard)
ADMIN_TOKEN=changez-moi-avant-le-deploiement

# Frontend (Vite lit les variables préfixées VITE_)
# Dev : http://localhost:3011 — Prod embed La Forge : /atlas-embed
VITE_API_URL=http://localhost:3011
